---
import Base from "../layouts/Base.astro";
import CabecaPagina from "../components/CabecaPagina.astro";
import Chamada from "../components/Chamada.astro";
import { SITE, CARGOS } from "../config";
import { ICONE } from "../lib/icones";
import equipe from "../data/equipe.json";

const valores = [
  ["Excelência jurídica", "Decisões fundamentadas na Lei 13.445/2017, no Decreto 9.199/2017 e nas resoluções do CNIg."],
  ["Transparência radical", "Orçamento, prazos estimados e status em tempo real."],
  ["Empatia e acolhimento", "Respeito às diferenças culturais e linguísticas."],
  ["Inovação responsável", "IA e automação a serviço de pessoas, nunca o contrário."],
  ["Diversidade e ESG", "Valorizar a pluralidade cultural, a ética empresarial e uma governança sólida e transparente."],
  ["Confidencialidade absoluta", "Proteção de dados conforme a LGPD e padrões ISO 27001."],
];
const socios = [...equipe].sort((a) => (a.slug === "walter-gama" ? -1 : 1));
---
<Base titulo="Quem Somos" descricao={`Fundada em ${SITE.fundacao}, a Imigrar Brasil une advocacia especializada em direito migratório, tecnologia e acolhimento para tornar a vida do estrangeiro no Brasil segura e previsível.`}>
  <CabecaPagina titulo="Uma assessoria feita de pessoas, tecnologia e confiança." sobretitulo="Sobre nós" migalhas={[{ rotulo: "Quem Somos" }]} />

  <section class="secao">
    <div class="container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(32px,5vw,72px);align-items:start">
      <div class="prosa">
        <p>Fundada em {SITE.fundacao}, a Imigrar Brasil nasceu para transformar burocracia em acolhimento. Unimos advocacia especializada, automação inteligente e empatia real para oferecer uma jornada migratória mais leve, transparente e segura — do visto à residência.</p>
        <p>Atendemos clientes de todo o mundo com ética, excelência técnica e foco em resultados, em português, espanhol, inglês e francês.</p>
      </div>
      <ul class="grade grade-2" style="list-style:none;padding:0;margin:0">
        {SITE.numeros.map((n) => (
          <li class="caixa" style="text-align:center;padding:28px 16px">
            <strong style="display:block;font:800 clamp(1.9rem,3.6vw,2.6rem)/1 var(--f-titulo);color:var(--carimbo)">{n.valor}</strong>
            <span style="color:var(--slate)">{n.rotulo}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao secao-casa">
    <div class="container grade grade-2" style="gap:clamp(24px,4vw,48px)">
      <div>
        <span class="sobretitulo">Missão</span>
        <h2>Tornar a vida do estrangeiro no Brasil juridicamente segura, organizada e previsível.</h2>
        <p>Atuamos para que cada pessoa, família ou empresa possa tomar decisões migratórias com clareza, consciência dos riscos e pleno conhecimento de seus direitos, sem se perder na burocracia.</p>
      </div>
      <div>
        <span class="sobretitulo">Visão</span>
        <h2>Ser, até 2030, a plataforma latino-americana de referência em mobilidade internacional.</h2>
        <p>Reconhecida por transformar burocracia em experiência fluida e por impulsionar o crescimento econômico por meio da circulação responsável de pessoas — construindo pontes duradouras entre o Brasil e o mundo.</p>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="cabeca-secao"><span class="sobretitulo">Valores</span><h2>O que guia cada caso</h2></div>
      <ul class="grade grade-3" style="list-style:none;padding:0;margin:0">
        {valores.map(([t, d], i) => (
          <li class="caixa">
            <span style="font:800 .85rem var(--f-titulo);color:var(--selo);letter-spacing:.1em">0{i + 1}</span>
            <h3 style="margin:8px 0 6px">{t}</h3>
            <p style="color:var(--slate);margin:0">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao secao-papel">
    <div class="container">
      <div class="cabeca-secao"><span class="sobretitulo">Diretoria</span><h2>Liderança especializada. Compromisso com resultados.</h2></div>
      <div class="grade grade-2">
        {socios.map((p) => (
          <article class="card" style="flex-direction:row">
            <div style="flex:0 0 40%;background:var(--papel)"><img src={p.foto} alt={p.nome} width="400" height="500" loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
            <div class="card-corpo" style="justify-content:center">
              <span class="chip" style="align-self:flex-start">{CARGOS[p.slug]}</span>
              <h3 style="font-size:1.35rem"><a class="card-link" href={`/equipe/${p.slug}/`}>{p.nome}</a></h3>
              <span class="link-seta" aria-hidden="true">Ver perfil</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao"><div class="container"><Chamada /></div></section>
</Base>
