---
// Carrossel infinito, 100% da largura, que não para. A lista é duplicada para o loop
// emendar sem salto; a cópia é escondida de leitores de tela.
import depoimentos from "../data/depoimentos.json";
import Img from "./Img.astro";
import { textoPuro } from "../lib/util";
interface Props { titulo?: boolean }
const { titulo = true } = Astro.props;
const lista = depoimentos.map((d) => {
  const t = textoPuro(d.html);
  return { ...d, resumo: t.length > 230 ? t.slice(0, t.lastIndexOf(" ", 220)) + "…" : t };
});
const cartao = (d: (typeof lista)[number], copia: boolean) => ({ d, copia });
const itens = [...lista.map((d) => cartao(d, false)), ...lista.map((d) => cartao(d, true)), ...lista.map((d) => cartao(d, true)), ...lista.map((d) => cartao(d, true))];
---
<section class="secao secao-papel" style="overflow:hidden" aria-label="Depoimentos de clientes">
  {titulo && (
    <div class="container cabeca-secao centro" data-revelar>
      <span class="sobretitulo">Depoimentos</span>
      <h2>Histórias reais de transformação</h2>
    </div>
  )}
  <div class="esteira" style="--duracao:70s;--vao:24px">
    <ul class="esteira-trilho" style="list-style:none;margin:0;padding:8px 0 16px">
      {itens.map(({ d, copia }) => (
        <li aria-hidden={copia ? "true" : undefined}>
          <figure class="depo" style="margin:0">
            <blockquote>{d.resumo}</blockquote>
            <footer>
              <Img src={d.foto} width={52} height={52} />
              <figcaption><cite>{d.nome}</cite><span>{d.origem} · <a href={`/depoimento/${d.slug}/`} tabindex={copia ? -1 : undefined}>ler depoimento</a></span></figcaption>
            </footer>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
