# ─────────────────────────────────────────────────────────────────────────────
# Imigrar Brasil — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) e cole as mesmas em Vercel → Settings →
# Environment Variables (produção).
#
# O app SOBE SEM NENHUMA DELAS: sem Supabase usa repositório em memória, sem DeepSeek
# roda o motor determinístico, sem Z-API não envia WhatsApp. Isso é bom para navegar no
# painel e ruim para tudo mais — a lista abaixo diz o que cada ausência custa.
#
# Confira o que está ligado em /api/health.
#
# NUNCA reaproveite credenciais de outro cliente aqui. A instância Z-API é dedicada por
# operação: herdar a de outra faz este agente responder pelo WhatsApp da outra empresa.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBRIGATÓRIAS EM PRODUÇÃO ─────────────────────────────────────────────────

# Supabase. SEM ISTO O APP RODA EM MEMÓRIA — e em produção serverless cada requisição
# pode cair numa instância diferente, então o que foi "salvo" some no refresh. Aplique
# as migrations de supabase/migrations/ em ordem antes do primeiro deploy.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo de sessão do painel (JWT). Gere com: openssl rand -base64 48
# Em produção o login FALHA ALTO se estiver vazio — de propósito.
AUTH_SECRET=

# DeepSeek — o provedor de LLM do agente. Sem esta chave o app cai no caminho
# determinístico (lib/agent/fallback.ts): ele triaga e encaminha, mas com um repertório
# curto e sem conduzir a conversa. É o piso seguro, não o produto.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Z-API — o gateway de WhatsApp. Instância DEDICADA desta operação.
# Também dá para salvar pelo painel (Integrações), que tem precedência sobre estas.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segredo do webhook. Configure a URL na Z-API como:
#   https://SEU-DOMINIO/api/webhook/whatsapp?token=<este valor>
# Em produção, vazio = o webhook REJEITA TUDO (fail-closed). É o que impede um terceiro
# que descubra a URL de mandar WhatsApp pela sua conta e injetar conversas.
WEBHOOK_VERIFY_TOKEN=

# URL pública do app. Entra nos links de proposta e no e-mail.
NEXT_PUBLIC_APP_URL=https://SEU-DOMINIO


# ── BASE DE CONHECIMENTO JURÍDICA (RAG) ──────────────────────────────────────
#
# Sem isto a Ana NÃO RESPONDE NADA sobre imigração: o prompt manda responder só com base
# no material oficial, então sem material ela diz que não tem a informação e encaminha
# tudo. É o comportamento seguro, mas não é o produto.
#
# Estas variáveis são as MESMAS do ingestao/embed_upsert.py, com os mesmos defaults, de
# propósito: o vetor da consulta tem de sair do mesmo modelo e da mesma dimensão que
# indexaram os chunks. Divergir aqui não dá erro — dá recuperação silenciosamente ruim.

OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_DIM=1024
# Só para EMBEDDINGS_PROVIDER=tei (BGE-M3 / multilingual-e5-large auto-hospedado):
EMBEDDINGS_URL=

# Transcrição do áudio do WhatsApp. Usa a MESMA OPENAI_API_KEY acima.
# Sem ela, quem manda voz — que neste público é muita gente — recebe um pedido para
# escrever, e o atendimento fica pela metade.
OPENAI_TRANSCRIBE_MODEL=whisper-1


# ── OPCIONAIS ────────────────────────────────────────────────────────────────

# WhatsApp da equipe que recebe aviso de lead encaminhado (só dígitos, com DDI).
TEAM_WHATSAPP=

# E-mail que recebe currículo de candidato encaminhado pelo webhook.
# VAZIO = não encaminha. Não existe default: aqui havia um endereço herdado da
# duplicação, o que mandava currículo com anexo para outra empresa.
RH_EMAIL=

# Brevo — envio de e-mail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Imigrar Brasil

# Cron de follow-up. Na Vercel o header Authorization: Bearer é montado a partir daqui.
CRON_SECRET=

# Leitura de imagem/documento (visão). O DeepSeek text-only NÃO enxerga imagem: só
# preencha apontando para um modelo de visão em endpoint compatível com OpenAI.
# Vazio = o anexo é salvo e exibido no painel, a Ana só não lê o conteúdo.
DEEPSEEK_VISION_MODEL=
